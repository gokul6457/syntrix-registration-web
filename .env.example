# ========================================================
# SYNTRIX Event Web Portal - Environment Template
# ========================================================

# Database Backend: 'sqlite' or 'supabase'
DATABASE_BACKEND=sqlite

# Supabase Configuration (Required when DATABASE_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Security & Admin Authentication
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=change-me

# WhatsApp Community Link (Optional)
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/your-group-invite-code
